	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_word_frequency.dir/build.make CMakeFiles/test_word_frequency.dir/tests/test_word_frequency.cpp.s
.PHONY : tests/test_word_frequency.cpp.s

